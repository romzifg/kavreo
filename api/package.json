{
  "name": "kavreo-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "API Content Planner: script video pendek, ide konten, dan kalender konten dengan alur approval",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsup",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test:approval": "node --import tsx --test tests/approval.integration.test.mjs",
    "prisma:generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:status": "prisma migrate status",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bcryptjs": "3.0.3",
    "cors": "2.8.6",
    "dotenv": "18.0.5",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "nodemailer": "10.0.14",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "sanitize-html": "^2.18.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "^22.19.0",
    "@types/pg": "8.23.1",
    "@types/sanitize-html": "^2.16.2",
    "pino-pretty": "13.1.3",
    "prisma": "7.10.0",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
