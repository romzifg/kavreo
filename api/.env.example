# ── Server ──────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Asal frontend yang diizinkan (pisahkan dengan koma)
CORS_ORIGIN=http://localhost:5173
# URL frontend, dipakai untuk membuat tautan di email / WhatsApp
APP_URL=http://localhost:5173
# Isi 1 jika API berada di belakang reverse proxy (Nginx, Cloudflare, dsb.)
TRUST_PROXY=0

# ── Database (PostgreSQL) ───────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/content_planner?schema=public

# ── Auth ────────────────────────────────────────────────
# Wajib diganti di production (minimal 32 karakter)
JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter
JWT_EXPIRES_IN=7d

# Production: set a stable random secret >=32 characters for encrypted AI API keys.
# If omitted, encryption derives from JWT_SECRET. Rotating the secret requires saving AI keys again.
# AI_ENCRYPTION_KEY=
# Izinkan pendaftaran mandiri (role USER)
ALLOW_REGISTER=true

# ── Notifikasi (nonaktif secara default, aktifkan belakangan) ──
NOTIFY_EMAIL_ENABLED=false
NOTIFY_WHATSAPP_ENABLED=false

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Content Planner <no-reply@example.com>"

# WhatsApp: fonnte | webhook
WA_PROVIDER=fonnte
# Kosongkan untuk memakai default provider (Fonnte: https://api.fonnte.com/send)
WA_API_URL=
WA_API_TOKEN=

# ── Seed (npm run db:seed) ──────────────────────────────
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_EMAIL=admin@contentplanner.test
SEED_ADMIN_PASSWORD=Admin12345!
SEED_DEMO_DATA=true
